# Copy to .env and fill in. Never commit .env.
DO_MODEL_ACCESS_KEY=sk-do-...          # Control Panel -> Gradient AI -> Serverless Inference -> Model Access Keys
MODEL=anthropic-claude-sonnet-5.5      # any tool-calling model from GET https://inference.do-ai.run/v1/models
INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DATASET_BASE_URL=https://examplekart-dataset-ovp33.ondigitalocean.app
MAX_STEPS=16
MAX_TOOL_RESULT_CHARS=14000
